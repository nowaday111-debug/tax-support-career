PORT=3000
# real = kết nối cổng thật dichvucong.gdt.gov.vn ; mock = cổng giả lập trong máy (dữ liệu bịa, để dùng thử)
DVC_MODE=real
# 1 = chạy Chromium ẩn; 0 = hiện cửa sổ trình duyệt (để quan sát / gỡ lỗi)
DVC_HEADLESS=1
# Nghỉ giữa các yêu cầu tới cổng (ms) — đừng đặt quá thấp để tránh bị chặn
DVC_DELAY_MS=1200
# Tự đọc captcha (1 = bật, 0 = luôn nhập tay) và số lần tự thử mỗi lượt trước khi hỏi người dùng
DVC_CAPTCHA_AUTO=1
DVC_CAPTCHA_AUTO_TRIES=3
# Chỉ dùng khi kiểm thử với cổng giả lập HTTP (npm run fake-portal)
# DVC_BASE_URL=http://localhost:4555
